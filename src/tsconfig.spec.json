{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/spec",
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "src/*": ["./*"],
      "projects/*": ["../projects/*"],
      "design-angular-kit/*": ["../projects/design-angular-kit/src/lib/*"]
    },
    "typeRoots": ["../node_modules/@types", "../node_modules"]
  },
  "include": [
    "**/*.spec.ts",
    "test-setup.ts",
    "**/*.d.ts"
  ]
}
