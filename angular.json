{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "design-angular-kit-bundle": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "it",
      "schematics": {
        "@schematics/angular:component": {
          "style": "none",
          "standalone": false,
          "skipTests": true
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/design-angular-kit-bundle"
            },
            "index": "src/index.html",
            "polyfills": [
              "zone.js",
              "@angular/localize/init"
            ],
            "tsConfig": "src/tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "**/*",
                "input": "./node_modules/bootstrap-italia/",
                "output": "/bootstrap-italia/"
              },
              {
                "glob": "**/*",
                "input": "./projects/design-angular-kit/assets/i18n",
                "output": "/bootstrap-italia/i18n/"
              }
            ],
            "styles": [
              "node_modules/highlight.js/styles/github.css",
              "src/styles.scss"
            ],
            "allowedCommonJsDependencies": [
              "progressbar.js",
              "accessible-autocomplete",
              "ev-emitter/ev-emitter",
              "@videojs/xhr",
              "global/document",
              "global/window",
              "keycode",
              "mux.js/lib/tools/parse-sidx",
              "mux.js/lib/utils/clock",
              "safe-json-parse/tuple",
              "videojs-vtt.js",
              "@xmldom/xmldom"
            ],
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "browser": "src/main.ts",
            "stylePreprocessorOptions": {
              "sass": {
                "silenceDeprecations": [
                  "import",
                  "if-function",
                  "color-functions",
                  "global-builtin",
                  "slash-div",
                  "abs-percent"
                ]
              }
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "design-angular-kit-bundle:build",
            "host": "127.0.0.1"
          },
          "configurations": {
            "production": {
              "buildTarget": "design-angular-kit-bundle:build:production"
            },
            "development": {
              "buildTarget": "design-angular-kit-bundle:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "design-angular-kit-bundle:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing",
              "@angular/localize/init"
            ],
            "tsConfig": "src/tsconfig.spec.json",
            "karmaConfig": "src/karma.conf.js",
            "styles": [
              "src/styles.scss"
            ],
            "codeCoverage": true,
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "stylePreprocessorOptions": {
              "sass": {
                "silenceDeprecations": [
                  "import",
                  "if-function",
                  "color-functions",
                  "global-builtin",
                  "slash-div",
                  "abs-percent"
                ]
              }
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    },
    "design-angular-kit": {
      "root": "projects/design-angular-kit",
      "sourceRoot": "projects/design-angular-kit/src",
      "projectType": "library",
      "prefix": "it",
      "schematics": {
        "@schematics/angular:component": {
          "style": "none",
          "changeDetection": "OnPush"
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "projects/design-angular-kit/tsconfig.lib.json",
            "project": "projects/design-angular-kit/ng-package.json"
          },
          "configurations": {
            "production": {
              "project": "projects/design-angular-kit/ng-package.prod.json",
              "tsConfig": "projects/design-angular-kit/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/design-angular-kit/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing",
              "@angular/localize/init"
            ],
            "tsConfig": "projects/design-angular-kit/tsconfig.spec.json",
            "karmaConfig": "projects/design-angular-kit/karma.conf.js",
            "codeCoverage": true,
            "assets": [
              {
                "glob": "**/*",
                "input": "./node_modules/bootstrap-italia/",
                "output": "/bootstrap-italia/"
              }
            ],
            "stylePreprocessorOptions": {
              "sass": {
                "silenceDeprecations": [
                  "import",
                  "if-function",
                  "color-functions",
                  "global-builtin",
                  "slash-div",
                  "abs-percent"
                ]
              }
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/design-angular-kit/**/*.ts",
              "projects/design-angular-kit/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "schematicCollections": [
      "@angular-eslint/schematics"
    ]
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
